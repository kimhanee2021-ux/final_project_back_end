STEAM_API_KEY=
#MySQL 접속 정보 (예: jdbc:mysql://localhost:3306/final_project?serverTimezone=Asia/Seoul)
DB_URL=
DB_USERNAME=
DB_PASSWORD=
#JWT 시크릿 키 - 32자 이상
JWT_SECRET_KEY=
#프론트엔드 주소(CORS 허용용) - 비워두면 http://localhost:5173
FRONTEND_BASE_URL=
#개발용 초기 데이터 시드 개수 - 기동 시 앞쪽 N개 게임의 목록과 상세정보를 DB에 저장한다. 0이면 실행하지 않음 (빈 값으로 두면 기동 실패하므로 반드시 숫자로 둘 것)
GAME_SEED_LIMIT=0
#(선택, 개발용) games 전체 12만 건의 원화 가격을 미리 받기 - 보유 게임 가격은 소비 분석 조회 때 자동으로 채워지므로 평소엔 비워둔다(false). 켜면 약 1시간 백그라운드 실행
SEED_PRICES_ENABLED=
#(선택) AI 게임 소비 코치용 Gemini 키 - https://aistudio.google.com 에서 발급. 비워 두면 코치 질문 시 503(AI_NOT_CONFIGURED). 실제 키는 .env에만 넣을 것
GEMINI_API_KEY=
#(선택) 코치가 쓰는 Gemini 모델, 기본 gemini-3.5-flash-lite (gemini-flash-latest는 혼잡 503이 잦음)
#GEMINI_COACH_MODEL=gemini-3.5-flash-lite
