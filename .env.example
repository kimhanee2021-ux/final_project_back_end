STEAM_API_KEY=
# Gemini API key (backend only; enter the real key in .env, never here)
GEMINI_API_KEY=
# Optional model; defaults to gemini-flash-latest
GEMINI_MODEL=gemini-flash-latest
#MySQL 접속 정보 (예: jdbc:mysql://localhost:3306/final_project?serverTimezone=Asia/Seoul)
DB_URL=
DB_USERNAME=
DB_PASSWORD=
#JWT 시크릿 키 - 32자 이상
JWT_SECRET_KEY=
#프론트엔드 주소(CORS 허용용) - 비워두면 http://localhost:5173
FRONTEND_BASE_URL=
#개발용 초기 데이터 시드 개수 - 기동 시 앞쪽 N개 게임의 목록과 상세정보를 DB에 저장한다. 0이면 실행하지 않음 (빈 값으로 두면 기동 실패하므로 반드시 숫자로 둘 것)
GAME_SEED_LIMIT=0

# AI 게임 취향 월드컵 전용 모델
GEMINI_WORLDCUP_MODEL=gemini-3.5-flash-lite

# AI 내 게임 매니저 (서버 전용)
GEMINI_MANAGER_MODEL=gemini-3.5-flash-lite
#(선택, 개발용) games 전체 12만 건의 원화 가격을 미리 받기 - 보유 게임 가격은 소비 분석 조회 때 자동으로 채워지므로 평소엔 비워둔다(false). 켜면 약 1시간 백그라운드 실행
SEED_PRICES_ENABLED=
