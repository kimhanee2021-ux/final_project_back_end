# ===== 필수 =====
#MySQL 접속 정보 (예: jdbc:mysql://localhost:3306/final_project?serverTimezone=Asia/Seoul)
DB_URL=
DB_USERNAME=
DB_PASSWORD=
#JWT 시크릿 키 - 32자 이상
JWT_SECRET_KEY=
STEAM_API_KEY=

# ===== 공통 =====
#프론트엔드 주소(CORS 허용용) - 비워두면 http://localhost:5173
FRONTEND_BASE_URL=
#게시판 이미지 저장 경로 (기본 ./uploads/board)
#BOARD_IMAGE_DIRECTORY=./uploads/board

# ===== AI 키 (backend only; 실제 키는 .env에만 입력, 여기엔 절대 넣지 말 것) =====
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
#Gemini 기본 모델 (기본 gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest
#Gemini API 베이스 URL (기본 https://generativelanguage.googleapis.com)
#GEMINI_BASE_URL=

# ===== PC 진단 =====
# auto: Gemini 우선, 제한/혼잡/시간초과 시 Groq로 1회 전환
PC_AI_PROVIDER=auto
# 일반 Gemini 모델과 독립
GEMINI_PC_MODEL=gemini-3.5-flash-lite
GROQ_PC_MODEL=qwen/qwen3.8-27b
GROQ_PC_MIN_INTERVAL_SECONDS=0

# ===== AI 게임 소비 코치 =====
#(선택) 키는 GEMINI_API_KEY 공용. 기본 gemini-3.5-flash-lite (gemini-flash-latest는 혼잡 503이 잦음)
#GEMINI_COACH_MODEL=gemini-3.5-flash-lite

# ===== 위시리스트 세일 / 조언 문장 (wishsales) =====
#(선택) IsThereAnyDeal API 키
ITAD_API_KEY=
#(선택) 조언 문장 생성 provider 우선순위, 쉼표 구분 (예: anthropic,gemini,groq). 기본 anthropic
#AI_PROVIDERS=anthropic
#ANTHROPIC_MODEL=claude-haiku-5-5
#GROQ_MODEL=llama-3.3-70b-versatile

# ===== 추천 모델 서버 (FastAPI) =====
#RECOMMEND_BASE_URL=http://localhost:8000
#RECOMMEND_TIMEOUT_SECONDS=30
#RECOMMEND_NEW_SLOTS=3
#RECOMMEND_CACHE_TTL_HOURS=24

# ===== 자연어 검색 =====
#GEMINI_SEARCH_MODEL=gemini-flash-latest
#SEARCH_LLM_TIMEOUT_SECONDS=15
#SEARCH_TIMEOUT_SECONDS=10

# ===== 랭킹 동기화 =====
#RANK_SYNC_ENABLED=false
#RANK_SCHEDULE_ENABLED=false
#RANK_SYNC_CRON=0 0 6 * * *

# ===== 개발용 데이터 시드 / 가격 동기화 =====
#games CSV 시드 (기본 true), 청크 크기, 쓰기 스레드 수
#SEED_GAMES_ENABLED=true
#SEED_GAMES_CHUNK_SIZE=2000
#SEED_GAMES_WRITER_THREADS=4
#(선택, 개발용) games 전체 12만 건의 원화 가격을 미리 받기 - 보유 게임 가격은 소비 분석 조회 때 자동으로 채워지므로 평소엔 비워둔다(false). 켜면 약 1시간 백그라운드 실행
SEED_PRICES_ENABLED=
#PRICE_SYNC_ENABLED=false
#PRICE_SYNC_CRON=0 30 3 * * *
#PRICE_SYNC_REQUEST_INTERVAL_MS=500

# ===== 추천(Featured) 게임 동기화 =====
#FEATURED_SYNC_CRON=0 10 4 * * *
#FEATURED_SYNC_ON_STARTUP=true
