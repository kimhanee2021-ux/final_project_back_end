STEAM_API_KEY=
# BBS voice search: OpenAI only. Keep the real key in backend .env or server environment.
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-transcribe
# Stage 3: enable only AFTER reviewing/applying docs/db/bbs-gpt-briefing-additive.sql.
BBS_BRIEFING_ENABLED=false
OPENAI_BBS_SUMMARY_MODEL=gpt-5.4-mini
# Stage 3 audio uses saved GPT narration only. No additional DB migration.
BBS_AUDIO_ENABLED=true
OPENAI_BBS_AUDIO_MODEL=gpt-realtime-2.1-mini
OPENAI_BBS_AUDIO_VOICE=marin
# Spoken game search / latest official briefing intent. Uses the same backend-only OpenAI key.
OPENAI_BBS_COMMAND_MODEL=gpt-5.4-mini
# Existing games are preserved; startup never imports the catalog automatically.
SEED_GAMES_ENABLED=false
# Disable unrelated background writes for an independent BBS local preview.
FEATURED_SYNC_ON_STARTUP=false
FEATURED_SYNC_CRON=-
# Gemini API key (backend only; enter the real key in .env, never here)
GEMINI_API_KEY=
# Optional model; defaults to gemini-flash-latest
GEMINI_MODEL=gemini-flash-latest
#MySQL 접속 정보 (예: jdbc:mysql://localhost:3306/final_project?serverTimezone=Asia/Seoul)
DB_URL=
DB_USERNAME=
DB_PASSWORD=
#JWT 시크릿 키 - 32자 이상
JWT_SECRET_KEY=
#프론트엔드 주소(CORS 허용용) - 비워두면 http://localhost:5173
FRONTEND_BASE_URL=http://localhost:9191
#개발용 초기 데이터 시드 개수 - 기동 시 앞쪽 N개 게임의 목록과 상세정보를 DB에 저장한다. 0이면 실행하지 않음 (빈 값으로 두면 기동 실패하므로 반드시 숫자로 둘 것)
GAME_SEED_LIMIT=0

# PC diagnosis only: auto uses Groq when GROQ_API_KEY is set, otherwise Gemini.
PC_AI_PROVIDER=auto
# auto: Gemini 우선, 제한/혼잡/시간초과 시 Groq로 1회 전환
GROQ_API_KEY=
GROQ_PC_MODEL=qwen/qwen3.8-27b
GROQ_PC_MIN_INTERVAL_SECONDS=0
#(선택, 개발용) games 전체 12만 건의 원화 가격을 미리 받기 - 보유 게임 가격은 소비 분석 조회 때 자동으로 채워지므로 평소엔 비워둔다(false). 켜면 약 1시간 백그라운드 실행
SEED_PRICES_ENABLED=false
#(선택) AI 게임 소비 코치가 쓰는 Gemini 모델. 키는 위의 GEMINI_API_KEY를 같이 쓴다. 기본 gemini-3.5-flash-lite (gemini-flash-latest는 혼잡 503이 잦음)
#GEMINI_COACH_MODEL=gemini-3.5-flash-lite

# PC diagnosis only: keep independent from the general Gemini alias
GEMINI_PC_MODEL=gemini-3.5-flash-lite

# BBS microphone captions: live streaming transcription (OpenAI only)
OPENAI_LIVE_STT_MODEL=gpt-live-transcribe
