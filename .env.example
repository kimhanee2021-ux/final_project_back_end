# ===== 필수 =====
#MySQL 접속 정보 (예: jdbc:mysql://localhost:3306/[db명]?serverTimezone=Asia/Seoul)
DB_URL=
DB_USERNAME=
DB_PASSWORD=
#JWT 시크릿 키 - 32자 이상
JWT_SECRET_KEY=
STEAM_API_KEY=
# Is There Any Deal API 키
ITAD_API_KEY=
# ===== 공통 =====
#프론트엔드 주소(CORS 허용용) - 비워두면 http://localhost:5173
FRONTEND_BASE_URL=http://localhost:9191
#개발용 초기 데이터 시드 개수 - 기동 시 앞쪽 N개 게임의 목록과 상세정보를 DB에 저장한다. 0이면 실행하지 않음 (빈 값으로 두면 기동 실패하므로 반드시 숫자로 둘 것)
GAME_SEED_LIMIT=0

# ===== AI 키 (backend only; 실제 키는 .env에만 입력, 여기엔 절대 넣지 말 것) =====
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
#Gemini 기본 모델 (기본 gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest

# ===== PC 진단 =====
# auto: Gemini 우선, 제한/혼잡/시간초과 시 Groq로 1회 전환
PC_AI_PROVIDER=auto
# 일반 Gemini 모델과 독립
GEMINI_PC_MODEL=gemini-3.5-flash-lite
GROQ_PC_MODEL=qwen/qwen3.8-27b
GROQ_PC_MIN_INTERVAL_SECONDS=0

# ===== AI 게임 소비 코치 =====
#(선택) 키는 GEMINI_API_KEY 공용. 기본 gemini-3.5-flash-lite (gemini-flash-latest는 혼잡 503이 잦음)
#GEMINI_COACH_MODEL=gemini-3.5-flash-lite

# ===== 추천 모델 서버 (FastAPI) =====
#RECOMMEND_API_URL=http://localhost:8000

# ===== 게시판 음성 (OpenAI 전용) =====
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_LIVE_STT_MODEL=gpt-live-transcribe
OPENAI_BBS_SUMMARY_MODEL=gpt-5.4-mini
OPENAI_BBS_COMMAND_MODEL=gpt-5.4-mini
OPENAI_BBS_AUDIO_MODEL=gpt-realtime-2.1-mini
OPENAI_BBS_AUDIO_VOICE=marin
# docs/db/bbs-gpt-briefing-additive.sql 검토/적용 후에만 true
BBS_BRIEFING_ENABLED=false
BBS_AUDIO_ENABLED=true

# ===== 개발용 데이터 시드 / 가격 동기화 =====
# 기존 게임은 보존, 기동 시 카탈로그를 자동으로 가져오지 않음
SEED_GAMES_ENABLED=false
# 둘 다 true로 한 번 기동하면 비어있지 않은 games 테이블에 없는 CSV 게임만 추가, 이후 false로 되돌릴 것
SEED_GAMES_FILL_MISSING=false
#(선택, 개발용) games 전체 12만 건의 원화 가격을 미리 받기 - 보유 게임 가격은 소비 분석 조회 때 자동으로 채워지므로 평소엔 비워둔다(false). 켜면 약 1시간 백그라운드 실행
SEED_PRICES_ENABLED=false

# ===== 추천(Featured) 게임 동기화 =====
# 독립 로컬 미리보기에서 무관한 백그라운드 쓰기 끄기
FEATURED_SYNC_ON_STARTUP=false
FEATURED_SYNC_CRON=-
